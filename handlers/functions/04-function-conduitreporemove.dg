// conduitreporemove: removes a project and deletes its index.
values = form.get("values");
servicename = values.get("servicename").get("value");
me = user.get("email").toLowerCase();

admins = "";
try
{
	p = zoho.cliq.extension.getProperties("admins");
	if(p != null && p.get("admins") != null)
	{
		admins = p.get("admins").toString().toLowerCase();
	}
}
catch (err)
{
	admins = "";
}
if(!admins.toList(",").contains(me))
{
	return {"type":"form_error","text":"Only a Conduit admin can remove a repository."};
}

services = Map();
try
{
	p = zoho.cliq.extension.getProperties("services");
	if(p != null && p.get("services") != null)
	{
		services = p.get("services").toMap();
	}
}
catch (err)
{
	services = Map();
}
svc = services.get(servicename);
if(svc == null)
{
	return {"type":"form_error","text":"That project no longer exists."};
}
repoText = svc.get("owner") + "/" + svc.get("repo");
namespace = ifnull(svc.get("namespace"),"").toString();

indexer = Map();
try
{
	p = zoho.cliq.extension.getProperties("indexer");
	if(p != null && p.get("indexer") != null)
	{
		indexer = p.get("indexer").toMap();
	}
}
catch (err)
{
	indexer = Map();
}
indexState = "Not deleted";
if(namespace == "" || namespace == "null")
{
	indexState = "Nothing to delete";
}
else if(indexer.get("url") != null && indexer.get("secret") != null)
{
	forgetBody = Map();
	forgetBody.put("namespace",namespace);
	try
	{
		forgetResp = invokeurl
		[
			url :indexer.get("url") + "/forget"
			type :POST
			parameters:forgetBody.toString()
			headers:{"X-Conduit-Secret":indexer.get("secret"),"Content-Type":"application/json"}
			detailed:true
		];
		forgetCode = forgetResp.get("responseCode");
		if(forgetCode == 200)
		{
			indexState = "Deleted";
		}
		else if(forgetCode == 409)
		{
			return {"type":"form_error","text":"This repository is being indexed right now. Try again in a minute."};
		}
		else
		{
			indexState = "Not deleted (indexer answered " + forgetCode + ")";
		}
	}
	catch (err)
	{
		indexState = "Not deleted (indexer not reachable)";
	}
}

services.remove(servicename);
dataMap = Map();
dataMap.put("services",services.toString());
zoho.cliq.extension.setProperties(dataMap);

rows = List();
rows.add({"Project":servicename});
rows.add({"Repository":repoText});
rows.add({"Indexed code":indexState});
return {"text":"New bugs can no longer be filed for this project. Existing tickets are kept.","card":{"title":"Repository removed","theme":"modern-inline"},"slides":{{"type":"label","data":rows}}};
