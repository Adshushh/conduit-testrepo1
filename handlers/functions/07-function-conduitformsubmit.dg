			}
			fitNoteBlock = "\n\n*AI note:* " + fitNote;
		}
		fitUpdRoom = 990 - fitFilesBlock.length() - fitNoteBlock.length() - fitDescLen;
		if(fitUpdRoom < 300)
		{
			fitUpdRoom = 300;
		}
		fitUpdatesBlock = "";
		for each fitU2 in fitUpdates
		{
			if(fitTotal > fitUpdRoom)
			{
				fitTotal = fitTotal - fitU2.length();
			}
			else
			{
				fitUpdatesBlock = fitUpdatesBlock + fitU2;
			}
		}
		fitRoom = 990 - fitFilesBlock.length() - fitNoteBlock.length() - fitUpdatesBlock.length();
		if(fitRoom < 150)
		{
			fitRoom = 150;
		}
		fitDesc = fitDesc.trim();
		if(fitDesc.length() > fitRoom)
		{
			fitDesc = fitDesc.subString(0,fitRoom - 1) + "…";
		}
		tDetails = fitOut;
