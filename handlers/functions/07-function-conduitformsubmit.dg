	if(op == "wontfix")
	{
		stMetaText = "";
		stIndex = 0;
		for each stPart in meta
		{
			if(stIndex < 7 && !stPart.startsWith("S:"))
			{
				stValue = stPart;
				if(stIndex == 6 && stValue == "")
				{
					stValue = "-";
				}
				if(stIndex > 0)
				{
					stMetaText = stMetaText + ",";
				}
				stMetaText = stMetaText + stValue;
				stIndex = stIndex + 1;
			}
		}
		if(stIndex == 6)
		{
			stMetaText = stMetaText + ",-";
			stIndex = 7;
		}
		if(stIndex == 7)
		{
			try
			{
				zoho.cliq.updateRecord(dbName,recordId,{"meta":stMetaText + ",S:" + stText});
			}
			catch (err)
			{
				info "stats not saved";
			}
		}
		// closed tickets no longer count as duplicates
		try
		{
			p = zoho.cliq.extension.getProperties("indexer");
			closeSvc = services.get(tService);
