// conduitformsubmit: one handler for several forms, told apart by their name.
botName = "flux";
dbName = "conduittickets";
routeDb = "conduitroutes";
nowMs = zoho.currenttime.toLong();
formName = form.get("name");
values = form.get("values");
try
{
	p = zoho.cliq.extension.getProperties("admins");
	if(p != null && p.get("admins") != null)
	{
		admins = p.get("admins").toString();
	}
}
catch (err)
{
	admins = "";
}
admins = admins.toLowerCase();
isAdmin = admins.toList(",").contains(me);

if(formName == "settings")
{
	if(!isAdmin)
	{
		return {"type":"form_error","text":"Only a Conduit admin can change settings."};
	}
	picked = values.get("addadmins");
	unreadable = "";
	outsider = "";
	if(picked != null && picked.toString() != "" && picked.toString() != "[]")
	{
		pickList = List();
		if(picked.toString().startsWith("["))
		{
			pickList = picked.toString().toJSONList();
		}
		else
		{
			pickList.add(picked.toString());
		}
		for each pk in pickList
		{
			email = email.trim().toLowerCase();
			if(email.contains("@"))
			{
				if(!adminList.contains(email))
				{
					// Only people in this org can be added, so check the email with Cliq first.
					adminReached = false;
					memberProblem = "";
					memberEmail = email;
					memberUrl = "https://cliq.zoho.com/api/v2/users?status=active&limit=20&search=" + zoho.encryption.urlEncode(memberEmail);
					memberResp = invokeurl
					[
						url :memberUrl
						type :GET
						connection:"conduitcliq"
						detailed:true
					];
					memberCode = memberResp.get("responseCode").toString();
					if(memberCode == "200")
					{
						memberList = List();
						try
						{
							memberList = memberResp.get("responseText").toString().toMap().get("data").toString().toJSONList();
						}
						catch (err)
						{
							memberList = List();
						}
						for each memberItem in memberList
						{
							memberFound = ifnull(memberItem.toString().toMap().get("email_id"),"").toString().toLowerCase();
							if(memberFound == memberEmail)
							{
								adminReached = true;
							}
						}
					}
					else
					{
						memberProblem = "Couldn't check organization membership (Cliq said " + memberCode + "). An admin needs to re-authorize the conduitcliq connection.";
					}
					if(memberProblem != "")
					{
						return {"type":"form_error","text":memberProblem};
					}
					if(adminReached)
					{
						adminList.add(email);
					}
					else
					{
						outsider = email;
					}
				}
			}
			else
			{
				unreadable = pkText;
			}
		}
	}
	if(outsider != "")
	{
		return {"type":"form_error","text":outsider + " isn't a member of this organization, so they can't be an administrator.","inputs":{"addadmins":"Only members of this organization"}};
	}
	removeEmail = removeEmail.trim().toLowerCase();
	if(removeEmail != "" && removeEmail != me)
	{
		adminList.removeElement(removeEmail);
	}
	if(!adminList.contains(me))
	{
		adminList.add(me);
	}
	indexerUrl = ifnull(values.get("indexerurl"),"").toString().trim();
	if(indexerUrl.endsWith("/"))
	{
		indexerUrl = indexerUrl.subString(0,indexerUrl.length() - 1);
	}
	if(indexerUrl != "" && !indexerUrl.startsWith("https://"))
	{
		return {"type":"form_error","text":"The indexer URL must start with https://","inputs":{"indexerurl":"Enter a valid https:// URL"}};
	}
	if(remindText != "")
	{
		try
		{
			remindHours = remindText.toDecimal();
		}
		catch (err)
		{
			return {"type":"form_error","text":"Reminder interval must be a number.","inputs":{"remindhours":"Enter a number of hours"}};
		}
	}
	confidenceText = ifnull(values.get("minconfidence"),"").toString().trim().replaceAll("%","");
	minConfidence = 60;
	if(confidenceText != "")
	{
		if(!confidenceText.matches("[0-9]{1,3}"))
		{
			return {"type":"form_error","text":"Minimum routing confidence must be a whole number from 0 to 100.","inputs":{"minconfidence":"Enter a number from 0 to 100"}};
		}
		minConfidence = confidenceText.toLong();
	}
	if(indexerUrl != "")
	{
		indexer.put("url",indexerUrl);
	}
	if(indexerSecret != "")
	{
		indexer.put("secret",indexerSecret);
	}
	dataMap = Map();
	dataMap.put("admins",newAdmins);
	// Keep other routing settings and change only the ones on this form.
	routing = Map();
	try
	{
		p = zoho.cliq.extension.getProperties("routing");
		if(p != null && p.get("routing") != null)
		{
			routing = p.get("routing").toMap();
		}
	}
	catch (err)
	{
		routing = Map();
	}
	routing.put("remindhours",remindHours);
	// stored as text, so readers can use ifnull with a text default
	routing.put("minconfidence",minConfidence.toString());

	zoho.cliq.extension.setProperties(dataMap);

	remindMins = (remindHours * 60).round(0).toLong();
	remindLabel = remindHours + " hours";
	if(remindMins < 60)
	{
		remindLabel = remindMins + " minutes";
	}
	else if(remindMins % 60 == 0)
	{
		remindLabel = (remindMins / 60) + " hours";
	}
	indexerState = "Not configured";
	aiState = "—";
	if(indexer.get("url") != null && indexer.get("secret") != null)
	{
		indexerState = "Not reachable";
		try
		{
			healthResp = invokeurl
			[
				url :indexer.get("url") + "/"
				type :GET
				detailed:true
			];
			if(healthResp.get("responseCode") == 200)
			{
				health = healthResp.get("responseText").toString().toMap();
				if(health.get("ok") == true)
				{
					indexerState = "Connected";
					aiState = ifnull(health.get("ai"),"—").toString().replaceAll("openai/","");
				}
				else
				{
					indexerState = "Misconfigured";
				}
			}
		}
		catch (err)
		{
			indexerState = "Not reachable";
		}
	}
	return {"text":"Configuration updated.","card":{"title":"Settings saved","theme":"modern-inline"},"slides":{{"type":"label","data":rows}}};
}
else if(formName == "linkdev")
{
	// a GitHub username (kept as typed), or the email they commit with (lowercased)
	github = values.get("github").toString().trim();
	if(github.startsWith("@"))
	{
		github = github.subString(1);
	}
	email = "";
	if(personText.startsWith("{"))
	{
		personMap = personText.toMap();
		for each emailKey in {"email","email_id","emailid","mail"}
		{
			if(email == "" && personMap.get(emailKey) != null)
			{
				email = personMap.get(emailKey).toString();
			}
		}
	}
	else if(personText.contains("@"))
	{
		email = personText;
	}
	// one entry per GitHub name, whatever its case
	githubLower = github.toLowerCase();
	existingKey = "";
	for each gk in people.keys()
	{
		if(gk.toLowerCase() == githubLower)
		{
			existingKey = gk;
		}
	}
	if(existingKey != "")
	{
		people.remove(existingKey);
	}
	// Only people in this org can be added, so check the email with Cliq first.
	devReached = false;
	memberProblem = "";
	[
		url :memberUrl
		type :GET
		connection:"conduitcliq"
		detailed:true
	];
	memberCode = memberResp.get("responseCode").toString();
	if(memberCode == "200")
	{
		memberList = List();
		try
		{
			memberList = memberResp.get("responseText").toString().toMap().get("data").toString().toJSONList();
		}
		catch (err)
		{
			memberList = List();
		}
		for each memberItem in memberList
		{
			memberFound = ifnull(memberItem.toString().toMap().get("email_id"),"").toString().toLowerCase();
			if(memberFound == memberEmail)
			{
				devReached = true;
			}
		}
	}
	else
	{
		memberProblem = "Couldn't check organization membership (Cliq said " + memberCode + "). An admin needs to re-authorize the conduitcliq connection.";
	}
	if(devReached)
	{
		try
		{
			zoho.cliq.postToBot(botName,{"text":myName + " linked the GitHub account *" + github + "* to you. Bugs in code by this account will now be routed to you.","userids":email});
		}
		catch (err)
		{
			info "could not send the welcome message";
		}
	}
	return {"text":"Bugs in this developers code will now be routed to them.","card":{"title":"Developer linked","theme":"modern-inline"},"slides":{{"type":"label","data":rows}}};
}
else if(formName == "teamleads")
{
	if(!isAdmin)
	{
		return {"type":"form_error","text":"Only a Conduit admin can change team leads."};
	}
	leadOrder = ifnull(values.get("leadorder"),"").toString();
	leadNames = leadOrder.toList(",");
	leadIndex = 0;
	badField = "";
	badText = "";
	changedCount = 0;
	rows = List();
	for each leadProject in leadNames
	{
		leadIndex = leadIndex + 1;
		fieldName = "lead" + leadIndex.toString();
		newLead = ifnull(values.get(fieldName),"").toString().trim().toLowerCase();
		if(!newLead.contains("@"))
		{
			if(badField == "")
			{
				badField = fieldName;
				badText = "Enter the team lead Cliq email for " + leadProject + ".";
			}
		}
		else if(services.containsKey(leadProject))
		{
			leadSvc = services.get(leadProject);
			oldLead = ifnull(leadSvc.get("teamlead"),"").toString().toLowerCase();
			if(newLead != oldLead)
			{
				memberEmail = newLead;
				memberUrl = "https://cliq.zoho.com/api/v2/users?status=active&limit=20&search=" + zoho.encryption.urlEncode(memberEmail);
				memberResp = invokeurl
					connection:"conduitcliq"
					detailed:true
				];
				memberCode = memberResp.get("responseCode").toString();
				if(memberCode == "200")
				{
					memberList = List();
					try
					{
						memberList = memberResp.get("responseText").toString().toMap().get("data").toString().toJSONList();
					}
					catch (err)
					{
						memberList = List();
					}
					for each memberItem in memberList
					{
						memberFound = ifnull(memberItem.toString().toMap().get("email_id"),"").toString().toLowerCase();
						if(memberFound == memberEmail)
						{
							reached = true;
						}
					}
				}
				else
				{
					memberProblem = "Couldn't check organization membership (Cliq said " + memberCode + "). An admin needs to re-authorize the conduitcliq connection.";
				}
				if(reached)
				{
					try
					{
						zoho.cliq.postToBot(botName,{"text":"You are now the team lead for *" + leadProject + "* in Conduit. Bugs nobody owns yet will come to you.","userids":newLead});
					}
					catch (err)
					{
						info "could not send the welcome message";
					}
				}
			}
			else
			{
				leadRow = Map();
				leadRow.put(leadProject,newLead);
				rows.add(leadRow);
			}
		}
	}
	if(badField != "")
	{
		badInputs = Map();
		badInputs.put(badField,badText);
		return {"type":"form_error","text":badText,"inputs":badInputs};
	}
	return {"text":"Bugs nobody owns yet go to these team leads.","card":{"title":"Team leads saved","theme":"modern-inline"},"slides":{{"type":"label","data":rows}}};
}
else if(formName == "membersadd" || formName == "membersremove")
{
	if(!isAdmin)
	{
		return {"type":"form_error","text":"Only a Conduit admin can change project members."};
	}
	if(formName == "membersremove")
	{
		chosenText = ifnull(values.get("members"),"").toString();
		keyMap = Map();
		try
		{
			keyMap = ifnull(values.get("memberkeys"),"").toString().toMap();
		}
		catch (err)
		{
			keyMap = Map();
		}
		removedRows = List();
		for each removeId in keyMap.keys()
		{
			// ids are mem_01 to mem_40, so one can never be part of another
			if(chosenText.contains(removeId))
			{
				removePair = keyMap.get(removeId).toString();
				removeProject = removePair.getPrefix("|");
				removeEmail = removePair.getSuffix("|");
				removeSvc = services.get(removeProject);
				if(removeSvc != null)
				{
					keptMembers = List();
					oldMembersList = ifnull(removeSvc.get("members"),"").toString().toList(",");
					for each oldMember in oldMembersList
					{
						if(oldMember.trim() != "" && oldMember.trim() != removeEmail)
						{
							keptMembers.add(oldMember.trim());
						}
					}
					joined1 = "";
					for each joinItem1 in keptMembers
					{
						if(joined1 != "")
						{
							joined1 = joined1 + ",";
						}
						joined1 = joined1 + joinItem1;
					}
					removeSvc.put("members",joined1);
					services.put(removeProject,removeSvc);
					removedRows.add({"Project":removeProject,"Removed":removeEmail});
				}
			}
		}
		if(removedRows.size() == 0)
		{
			return {"type":"form_error","text":"Choose at least one member to remove."};
		}
		zoho.cliq.extension.setProperties({"services":services.toString()});
		return {"text":"Their tickets stay as they are. Team leads no longer see their numbers for these projects.","card":{"title":"Members removed","theme":"modern-inline"},"slides":{{"type":"table","data":{"headers":{"Project","Removed"},"rows":removedRows}}}};
	}
	// Report the real problem instead of the generic Cliq error.
	try
	{
		picked = values.get("addmembers");
		pickList = List();
		if(picked != null && picked.toString().startsWith("["))
		{
			pickList = picked.toString().toJSONList();
		}
		else if(picked != null && picked.toString() != "")
		{
			pickList.add(picked.toString());
		}
		addedRows = List();
		for each pk in pickList
		{
			pkText = pk.toString().trim();
			email = "";
			if(pkText.startsWith("{"))
			{
				pm = pkText.toMap();
				for each k in {"email","email_id","emailid","mail"}
				{
					if(email == "" && pm.get(k) != null)
					{
						email = pm.get(k).toString();
					}
				}
			}
			else if(pkText.contains("@"))
			{
				email = pkText;
			}
			email = email.trim().toLowerCase();
			if(email.contains("@") && !memberNow.contains(email))
			{
				memberList = List();
				try
				{
					memberList = memberResp.get("responseText").toString().toMap().get("data").toString().toJSONList();
				}
				catch (err)
				{
					memberList = List();
				}
				if(!memberReached)
				{
					return {"type":"form_error","text":email + " isn't a member of this organization."};
				}
				memberNow.add(email);
				addedRows.add({"Added":email});
			}
		}
		joined2 = "";
		for each joinItem2 in memberNow
		{
			if(joined2 != "")
			{
				joined2 = joined2 + ",";
			}
			joined2 = joined2 + joinItem2;
		}
		addedRows.add({"Members now":memberNow.size().toString()});
		return {"text":"The " + addProject + " team lead now sees their numbers in Conduit stats.","card":{"title":"Members added to " + addProject,"theme":"modern-inline"},"slides":{{"type":"label","data":addedRows}}};
	}
	catch (err)
	{
		return {"type":"form_error","text":"Couldn't add members: " + err};
	}
}
else if(formName == "restoredev")
{
	services = Map();
	try
	{
		p = zoho.cliq.extension.getProperties("people");
		if(p != null && p.get("people") != null)
		{
			people = p.get("people").toMap();
		}
		p = zoho.cliq.extension.getProperties("peopleleft");
		if(p != null && p.get("peopleleft") != null)
		{
			peopleLeft = p.get("peopleleft").toMap();
		}
		p = zoho.cliq.extension.getProperties("services");
		if(p != null && p.get("services") != null)
		{
			services = p.get("services").toMap();
		}
	}
	catch (err)
	{
		return {"type":"form_error","text":"Couldn't read the developer list. Try again."};
	}
	memberList = List();
	try
	{
		memberList = memberResp.get("responseText").toString().toMap().get("data").toString().toJSONList();
	}
	catch (err)
	{
		memberList = List();
	}
	for each memberItem in memberList
	{
		memberFound = ifnull(memberItem.toString().toMap().get("email_id"),"").toString().toLowerCase();
		if(memberFound == restoreEmail)
		{
			memberReached = true;
		}
	}
	// Bring back every GitHub link of this person, and their project memberships.
	restoredNames = List();
	restoredProjects = List();
	leftKeys = List();
	for each leftGh in peopleLeft.keys()
	{
		leftKeys.add(leftGh);
	}
	for each restoreProject in restoredProjects
	{
		restoreSvc = services.get(restoreProject);
		if(restoreSvc != null)
		{
			restoreMembers = ifnull(restoreSvc.get("members"),"").toString().toList(",");
			if(!restoreMembers.contains(restoreEmail))
			{
				restoreMembers.add(restoreEmail);
				joined3 = "";
				for each joinItem3 in restoreMembers
				{
					if(joined3 != "")
					{
						joined3 = joined3 + ",";
					}
					joined3 = joined3 + joinItem3;
				}
				restoreSvc.put("members",joined3);
				services.put(restoreProject,restoreSvc);
			}
		}
	}
	zoho.cliq.extension.setProperties({"people":people.toString(),"peopleleft":peopleLeft.toString(),"services":services.toString()});
	restoreRows = List();
	restoreRows.add({"Cliq user":restoreEmail});
	joined4 = "";
	for each joinItem4 in restoredNames
	{
		if(joined4 != "")
		{
			joined4 = joined4 + ", ";
		}
		joined4 = joined4 + joinItem4;
	}
	restoreRows.add({"Member of":projectsText});
	return {"text":"New bugs in their code can reach them again.","card":{"title":"Developer restored","theme":"modern-inline"},"slides":{{"type":"label","data":restoreRows}}};
}
else if(formName == "unlinkdev")
{
	if(!isAdmin)
	{
		return {"type":"form_error","text":"Only a Conduit admin can unlink developers."};
	}
	github = values.get("github").get("value").toString();
	people = Map();
	try
	{
		p = zoho.cliq.extension.getProperties("people");
		if(p != null && p.get("people") != null)
		{
			people = p.get("people").toMap();
		}
	}
	catch (err)
	{
		people = Map();
	}
	oldEmail = ifnull(people.get(github),"").toString();
	people.remove(github);
	zoho.cliq.extension.setProperties({"people":people.toString()});
	rows = List();
	rows.add({"GitHub user":github});
	rows.add({"Cliq user":oldEmail});
	rows.add({"Linked developers":people.size().toString()});
	return {"text":"New bugs will skip this developer. Tickets they already have stay with them.","card":{"title":"Developer unlinked","theme":"modern-inline"},"slides":{{"type":"label","data":rows}}};
}
else if(formName == "ticketnote")
{
	msgId = "";
	msgRef = ifnull(values.get("msgref"),"").toString();
	if(msgRef.contains("|"))
	{
		msgChat = msgRef.getPrefix("|");
		msgId = msgRef.getSuffix("|");
	}
	ticket = ticketResp.get("object");
	ticketId = ticket.get("ticketid");
	status = ticket.get("status");
	assignee = ifnull(ticket.get("assignee"),"unassigned");
	tTitle = ticket.get("title");
	tDetails = ifnull(ticket.get("details"),"");
	// meta: severity, project, chat, reporter, escalate to, reminder hours, followers
	meta = ticket.get("meta").toList();
	// The stats record lives in meta field 8 as S:key=value;key=value
	stMap = Map();
	for each stPart in meta
	{
		if(stPart.startsWith("S:"))
		{
			stPairs = stPart.subString(2).toList(";");
			for each stPair in stPairs
			{
				if(stPair.contains("="))
				{
					stMap.put(stPair.getPrefix("="),stPair.getSuffix("="));
				}
			}
		}
	}
	reporter = meta.get(3);
	// Field 7 lists people who reported the same bug and joined this ticket.
	followers = "";
	// "-" marks an empty follower list when the stats record follows it
	if(followers == "-")
	{
		followers = "";
	}
	reminders = 0;
	routeResp = zoho.cliq.getRecords(routeDb,{"criteria":"ticketrec==" + recordId});
	if(routeResp.get("status") != null && routeResp.get("status").equalsIgnoreCase("SUCCESS") && routeResp.get("list").size() > 0)
	{
		routeRec = routeResp.get("list").get(0);
		routeId = routeRec.get("id").toString();
		declined = ifnull(routeRec.get("declined"),"").toString();
		pending = ifnull(routeRec.get("pending"),"").toString();
		questions = ifnull(routeRec.get("questions"),"").toString();
		reminders = ifnull(routeRec.get("reminders"),0).toLong();
		try
		{
			candList = routeRec.get("candidates").toString().toJSONList();
		}
		catch (err)
		{
			candList = List();
		}
	}
	services = Map();
	try
	{
		p = zoho.cliq.extension.getProperties("services");
		if(p != null && p.get("services") != null)
		{
			services = p.get("services").toMap();
		}
	}
	catch (err)
	{
		services = Map();
	}
	tcSvc = Map();
	if(leadSvc != null)
	{
		tcSvc = leadSvc;
	}
	tcAssignee = assignee;
	// Ticket card: title and description as text, everything else as slides.
	// details is the description followed by sections like *AI note:* and *Likely files:*
	tcNote = "";
	tcFileText = "";
	tcExtra = "";
	tcPartNo = 0;
	for each tcPart in tcParts
	{
		if(tcPartNo == 0)
		{
			tcDesc = tcPart;
		}
		else if(tcPart.contains(":*"))
		{
			tcHead = tcPart.getPrefix(":*");
			tcBody = tcPart.getSuffix(":*").trim();
			if(tcHead == "AI note")
			{
				tcNote = tcBody;
			}
			else if(tcHead == "Likely files")
			{
				tcFileText = tcBody;
			}
			else
			{
				if(tcExtra != "")
				{
					tcExtra = tcExtra + "\n\n";
				}
				tcExtra = tcExtra + "*" + tcHead + ":* " + tcBody;
			}
		}
		else
		{
			tcDesc = tcDesc + "\n\n*" + tcPart;
		}
		tcPartNo = tcPartNo + 1;
	}
	tcProject = tcProjectName;
