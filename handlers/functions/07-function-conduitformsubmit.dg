			{
				candEmail = ifnull(cand.get("cliq"),"").toString().toLowerCase();
				if(newAssignee == "" && candEmail != "" && !declined.toList(",").contains(candEmail))
				{
					newAssignee = candEmail;
				}
			}
			// Below the minimum confidence, the team lead picks the owner instead.
			// Candidates carry pct (confidence) and share. The first also carries where, the AI view of the code.
			chosenPct = 100;
			whereText = "";
			confWho = "";
			whoShown = 0;
			for each pc in candList
			{
				pcEmail = ifnull(pc.get("cliq"),"").toString().toLowerCase();
				pcPct = ifnull(pc.get("pct"),"").toString();
				if(newAssignee != "" && pcEmail == newAssignee && pcPct.matches("[0-9]{1,3}"))
				{
					chosenPct = pcPct.toLong();
				}
				if(whereText == "")
				{
					whereText = ifnull(pc.get("where"),"").toString();
				}
				pcShare = ifnull(pc.get("share"),"").toString();
				if(whoShown < 3 && pcShare != "")
				{
					pcLabel = ifnull(pc.get("name"),"").toString();
					if(pcEmail != "")
					{
						pcLabel = pcLabel + " (" + pcEmail + ")";
					}
					else
					{
						pcLabel = pcLabel + ", not linked";
					}
					confWho = confWho + "\n   " + pcLabel + ": " + pcShare + "% of the matched code";
					whoShown = whoShown + 1;
				}
			}
			confText = "";
			if(lowConfidence)
			{
				filled = (chosenPct.toDecimal() / 20).round(0);
				meter = "";
				for each step in {1,2,3,4,5}
				{
					if(step <= filled)
					{
						meter = meter + "▰";
					}
					else
					{
						meter = meter + "▱";
					}
				}
				confText = "\n\n*Routing confidence:* " + meter + " " + chosenPct.toString() + "% (minimum " + minConfidence.toString() + "%)";
			}
			openButtons.add({"label":"Need info","type":"+","key":"needinfo-" + recordId,"action":{"type":"invoke.function","data":{"name":"conduitticketaction"}}});
			routeOutcome = "";
			if(newAssignee != "")
			{
				delivered = true;
				try
				{
					dmMsg = Map();
					dmMsg.put("text",cardText);
					dmMsg.put("slides",tcSlides);
					dmMsg.put("card",{"title":ticketId + " · New bug for you","theme":"modern-inline"});
					dmMsg.put("buttons",openButtons);
					dmMsg.put("userids",newAssignee);
					dmResp = zoho.cliq.postToBot(botName,dmMsg);
					if(dmResp != null && dmResp.get("code") != null)
					{
						delivered = false;
					}
				}
				catch (err)
				{
					delivered = false;
				}
				if(delivered)
				{
					zoho.cliq.updateRecord(dbName,recordId,{"status":"Open","assignee":newAssignee});
					routeOutcome = "Routed to " + newAssignee + ".";
				}
				else
				{
					declined = declined + "," + newAssignee;
					routeOutcome = newAssignee + " couldn't be messaged (not subscribed to Flux). ";
					newAssignee = "";
				}
			}
			if(newAssignee == "")
			{
				zoho.cliq.updateRecord(dbName,recordId,{"status":"Open","assignee":"unassigned"});
				leadTitle = ticketId + " · Needs an owner";
				leadText = cardText;
				if(whereText != "")
				{
					tcWhere = whereText;
					if(tcWhere.length() > 1)
					{
						tcWhere = tcWhere.subString(0,1).toUpperCase() + tcWhere.subString(1);
					}
					tcConfRows.add({"Where":tcWhere});
				}
				// Sum up the top two candidates in one line.
				tcVerdict = "";
				if(candList.size() > 0)
				{
					tcFirst = candList.get(0);
					tcFirstName = ifnull(tcFirst.get("name"),"").toString();
					tcFirstShare = ifnull(tcFirst.get("share"),"").toString();
					if(ifnull(tcFirst.get("cliq"),"").toString() == "")
					{
						tcVerdict = "Most of the code is by " + tcFirstName + ", who is not linked to a Cliq user";
					}
					else if(candList.size() > 1)
					{
						tcSecond = candList.get(1);
						tcSecondShare = ifnull(tcSecond.get("share"),"").toString();
						tcVerdict = tcFirstName + " " + tcFirstShare + "%, " + ifnull(tcSecond.get("name"),"").toString() + " " + tcSecondShare + "%";
						if(tcFirstShare.matches("[0-9]{1,3}") && tcSecondShare.matches("[0-9]{1,3}"))
						{
							if(tcFirstShare.toLong() - tcSecondShare.toLong() < 15)
							{
								tcVerdict = "Close call: " + tcVerdict;
							}
						}
					}
					else if(tcFirstShare != "")
					{
						tcVerdict = "Clear owner: " + tcFirstName + " has " + tcFirstShare + "% of the matched code";
					}
				}
				leadButtons = List();
				if(lowConfidence)
				{
					// Close call: let the lead pick from the likely owners.
					leadTitle = ticketId + " · Who should own this?";
					assignShown = 0;
					candIndex = 0;
					for each ac in candList
					{
						acEmail = ifnull(ac.get("cliq"),"").toString().toLowerCase();
						if(assignShown < 2 && acEmail != "" && !declined.toList(",").contains(acEmail))
						{
							acName = ifnull(ac.get("name"),"").toString().trim();
							if(acName == "")
							{
								acName = acEmail.getPrefix("@");
							}
							if(acName.contains(" "))
							{
								acName = acName.getPrefix(" ");
							}
							// Buttons hold about 20 characters, so only really long names get shortened.
							if(acName.length() > 13)
							{
								acName = acName.subString(0,12) + "…";
							}
							acLabel = "Assign " + acName;
							assignButton = Map();
							assignButton.put("label",acLabel);
							assignButton.put("type","+");
							assignButton.put("key","assignto-" + recordId + "-" + candIndex.toString());
							assignButton.put("action",{"type":"invoke.function","data":{"name":"conduitticketaction"}});
							leadButtons.add(assignButton);
							assignShown = assignShown + 1;
						}
						candIndex = candIndex + 1;
					}
					for each b in openButtons
					{
						bKey = b.get("key");
						if(bKey.startsWith("forward-") || bKey.startsWith("needinfo-") || bKey.startsWith("wontfix-"))
						{
							leadButtons.add(b);
						}
					}
				}
				else
				{
				}
				adminsDelivered = true;
				try
				{
					dmMsg = Map();
					dmMsg.put("text",leadText);
					dmMsg.put("slides",tcDecideSlides);
					dmMsg.put("card",{"title":leadTitle,"theme":"modern-inline"});
					dmMsg.put("buttons",leadButtons);
					dmMsg.put("userids",escalateTo);
					dmResp = zoho.cliq.postToBot(botName,dmMsg);
					if(dmResp != null && dmResp.get("code") != null)
					{
						adminsDelivered = false;
					}
				}
				catch (err)
				{
					adminsDelivered = false;
				}
				routeOutcome = routeOutcome + "No linked developer is available for this bug, so it went to " + escalateName + ".";
			}
			stMetaText = "";
			stIndex = 0;
			for each stPart in meta
			{
				if(stIndex < 7 && !stPart.startsWith("S:"))
				{
					stValue = stPart;
					if(stIndex == 6 && stValue == "")
					{
						stValue = "-";
					}
					if(stIndex > 0)
					{
						stMetaText = stMetaText + ",";
					}
					stMetaText = stMetaText + stValue;
					stIndex = stIndex + 1;
				}
			}
			if(stIndex == 7)
			{
				try
				{
					zoho.cliq.updateRecord(dbName,recordId,{"meta":stMetaText + ",S:" + stText});
				}
				catch (err)
				{
					info "stats not saved";
				}
			}
			rRows = List();
			rRows.add({"Ticket":ticketId});
			rRows.add({"Project":tService});
			rRows.add({"Severity":tSeverity});
			rRows.add({"Status":rStatus});
			shotButtons = List();
			shotButtons.add({"label":"Add screenshots","type":"+","key":"attach-" + recordId,"action":{"type":"invoke.function","data":{"name":"conduitticketaction"}}});
			editMsg = {"text":"*" + tTitle + "*\nThanks for the details. You'll be notified here when a developer picks it up.","card":{"title":"Bug reported","theme":"modern-inline"},"slides":{{"type":"label","data":rRows}},"buttons":shotButtons};
			// Refresh the card that opened this form so its buttons go away.
			if(msgChat != "" && msgId != "")
			{
				editOk = false;
				try
				{
					editResp = zoho.cliq.editMessage(msgChat,msgId,editMsg,"conduitmsg");
					if(editResp != null && editResp.get("status") == "success")
					{
						editOk = true;
					}
				}
				catch (err)
				{
					editOk = false;
				}
				if(!editOk)
				{
					try
					{
						zoho.cliq.editMessage(msgChat,msgId,{"text":editMsg.get("text")},"conduitmsg");
					}
					catch (err)
					{
						info "could not update the card";
					}
				}
			}
			return {"text":"Thanks! " + ticketId + " has been sent to the team. You'll be notified here when a developer picks it up."};
		}

		zoho.cliq.updateRecord(dbName,recordId,{"status":previous});
		if(routeId != "")
		{
			zoho.cliq.updateRecord(routeDb,routeId,{"pending":"","reminders":0,"changedat":nowMs});
		}
		openButtons = List();
		openButtons.add({"label":"Accept","type":"+","key":"accept-" + recordId,"action":{"type":"invoke.function","data":{"name":"conduitticketaction"}}});
		openButtons.add({"label":"Not mine","type":"-","key":"notmine-" + recordId,"action":{"type":"invoke.function","data":{"name":"conduitticketaction"}}});
		workButtons = List();
		workButtons.add({"label":"Mark fixed","type":"+","key":"fixed-" + recordId,"action":{"type":"invoke.function","data":{"name":"conduitticketaction"}}});
		workButtons.add({"label":"Need info","type":"+","key":"needinfo-" + recordId,"action":{"type":"invoke.function","data":{"name":"conduitticketaction"}}});
		target = assignee;
		if(assignee == "unassigned")
		{
			target = escalateTo;
		}
		editMsg = {"text":"❓ Question about " + label + ":\n" + questions + "\n\n💬 *Answered.* Your answer was sent to the developer."};
		// Refresh the card that opened this form so its buttons go away.
		if(msgChat != "" && msgId != "")
		{
			editOk = false;
			try
			{
				editResp = zoho.cliq.editMessage(msgChat,msgId,editMsg,"conduitmsg");
				if(editResp != null && editResp.get("status") == "success")
				{
					editOk = true;
				}
			}
			catch (err)
			{
				editOk = false;
			}
			if(!editOk)
			{
				try
				{
					zoho.cliq.editMessage(msgChat,msgId,{"text":editMsg.get("text")},"conduitmsg");
				}
				catch (err)
				{
					info "could not update the card";
				}
			}
		}
		return {"text":"Thanks! Your answer was sent to the developer."};
	}
	return {"type":"form_error","text":"Unknown action."};
}
return {"text":"Unknown form."};
