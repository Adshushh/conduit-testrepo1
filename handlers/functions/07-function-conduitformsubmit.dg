		editMsg = {"text":cardInfo + "\n\n❓ *Question sent to the reporter:* " + note + "\nYou'll get their answer here.","card":{"title":ticketId + " · Waiting for reporter","theme":"modern-inline"},"slides":tcSlides};
		// Refresh the card that opened this form so its buttons go away.
