			if(svc != null && indexer.get("url") != null)
			{
				try
				{
					routeBody = Map();
					routeBody.put("repo",svc.get("owner") + "/" + svc.get("repo"));
					routeBody.put("namespace",svc.get("namespace"));
					routeBody.put("token",svc.get("token"));
					routeBody.put("title",tTitle);
					// The indexer rejects raw line breaks, so flatten the text.
					routeBody.put("description",tDetails.replaceAll("\n"," ").replaceAll("\r"," ").replaceAll("\t"," "));
					routeBody.put("severity",tSeverity);
					routeBody.put("people",people);
					[
						url :indexer.get("url") + "/route"
						type :POST
						parameters:routeBody.toString()
						headers:{"X-Conduit-Secret":indexer.get("secret"),"Content-Type":"application/json"}
						detailed:true
					];
					if(routeResp.get("responseCode") == 200)
					{
						if(codeConf != null)
						{
							whereNote = ifnull(codeConf.get("level"),"").toString();
							whereReason = ifnull(codeConf.get("reason"),"").toString();
							if(whereReason != "")
							{
								whereNote = whereNote + ": " + whereReason;
							}
							if(whereNote.length() > 140)
							{
								whereNote = whereNote.subString(0,140);
							}
						}
						compact = List();
						for each c in ifnull(reply.get("candidates"),List())
						{
							entry = Map();
							entry.put("cliq",ifnull(c.get("cliq"),"").toString());
							entry.put("name",ifnull(c.get("name"),"").toString());
							entry.put("key",ifnull(c.get("key"),"").toString());
							entryPct = "";
							if(c.get("confidence") != null)
							{
								entryPct = c.get("confidence").toString();
							}
							entry.put("pct",entryPct);
							entryShare = "";
							if(c.get("share") != null)
							{
								entryShare = c.get("share").toString();
							}
							entry.put("share",entryShare);
							if(compact.size() == 0 && whereNote != "")
							{
								entry.put("where",whereNote);
							}
							compact.add(entry);
						}
					}
				}
				catch (err)
				{
					info "re-route failed; using the first ranking";
				}
			}
			tcPartNo = 0;
			for each tcPart in tcParts
			{
				if(tcPartNo == 0)
				{
					tcDesc = tcPart;
				}
				else if(tcPart.contains(":*"))
				{
					tcHead = tcPart.getPrefix(":*");
					tcBody = tcPart.getSuffix(":*").trim();
					if(tcHead == "AI note")
					{
						tcNote = tcBody;
					}
					else if(tcHead == "Likely files")
					{
						tcFileText = tcBody;
					}
					else
					{
						if(tcExtra != "")
						{
							tcExtra = tcExtra + "\n\n";
						}
						tcExtra = tcExtra + "*" + tcHead + ":* " + tcBody;
					}
				}
				else
				{
					tcDesc = tcDesc + "\n\n*" + tcPart;
				}
				tcPartNo = tcPartNo + 1;
