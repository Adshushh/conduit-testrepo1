		{
			fwdList = fwdText.toJSONList();
			fwdText = "";
			if(fwdList.size() > 0)
			{
				fwdText = fwdList.get(0).toString().trim();
			}
		}
		newAssignee = "";
		if(fwdText.startsWith("{"))
		{
			fwdMap = fwdText.toMap();
