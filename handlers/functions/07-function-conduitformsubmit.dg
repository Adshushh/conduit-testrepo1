			{
				idx = p.get("indexer").toMap();
				removeBody = Map();
				removeBody.put("namespace",closeSvc.get("namespace"));
				removeBody.put("record_id",recordId);
				removeResp = invokeurl
				[
					url :idx.get("url") + "/tickets/remove"
					type :POST
					parameters:removeBody.toString()
					headers:{"X-Conduit-Secret":idx.get("secret"),"Content-Type":"application/json"}
				];
			}
		}
		catch (err)
		{
			info "could not remove the ticket from duplicate checks";
		}
		if(chat.get("id") != originChat)
		{
