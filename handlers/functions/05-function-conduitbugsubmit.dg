// conduitbugsubmit: files a bug, finds who wrote the code and sends it to them.
nowMs = zoho.currenttime.toLong();
values = form.get("values");
bugTitle = values.get("title").toString().trim();
reporter = user.get("email").toLowerCase();
clicker = reporter;
clickerName = user.get("first_name");
// filled only when the report came from "Report as bug" on a chat message
srcUser = ifnull(values.get("srcuser"),"").toString().trim().toLowerCase();
srcName = ifnull(values.get("srcname"),"").toString().trim();
if(srcName == "")
{
	srcName = reporter;
}
// Updates go to the reporter in Flux, never back to the channel.
originChat = "dm";

services = Map();
// match the typed project name; with only one project the field can be left blank
if(svcName == "" && services.size() == 1)
{
	svcName = services.keys().get(0);
}
if(services.get(svcName) == null)
{
	projectList = "";
	for each knownName in services.keys()
	{
		if(projectList != "")
		{
			projectList = projectList + ", ";
		}
		projectList = projectList + knownName;
	}
	return {"type":"form_error","text":"Choose one of these projects: " + projectList,"inputs":{"service":"Projects: " + projectList}};
}
admins = "";
try
{
	p = zoho.cliq.extension.getProperties("admins");
	if(p != null && p.get("admins") != null)
	{
		admins = p.get("admins").toString();
	}
}
catch (err)
{
	admins = "";
}
// urgent bugs are chased sooner: blocker within 1 hour, high within 2, low after twice the usual wait
baseHours = 4.0;
if(remindHours.matches("[0-9]+(\\.[0-9]+)?"))
{
	baseHours = remindHours.toDecimal();
}
if(severityKey == "high" && baseHours > 2)
{
	ticketHours = 2.0;
}
svcKey = svcName;
escalateTo = "";
leadSvc = services.get(svcKey);
if(leadSvc != null)
{
	escalateTo = ifnull(leadSvc.get("teamlead"),"").toString().trim().toLowerCase();
}
escalateName = "the " + svcKey + " team lead (" + escalateTo + ")";
if(escalateTo == "")
{
	escalateTo = admins;
	escalateName = "the Conduit admins (" + admins + "), because " + svcKey + " has no team lead set";
}
owner = svc.get("owner");
repo = svc.get("repo");

result = Map();
routeError = "";
if(indexer.get("url") == null || indexer.get("secret") == null)
{
	routeError = "The indexer isn't configured, so Conduit can't search the code. An admin can set it in /repo → Settings.";
}
else
{
}
files = ifnull(result.get("files"),List());
candidates = ifnull(result.get("candidates"),List());
aiNote = ifnull(result.get("note"),"").toString();
askList = ifnull(result.get("questions"),List());
routeNotes = "";
routeWarnings = ifnull(result.get("warnings"),List());
for each rw in routeWarnings
{
	if(routeNotes != "")
	{
		routeNotes = routeNotes + "; ";
	}
	routeNotes = routeNotes + rw.toString();
}
if(routeNotes.length() > 300)
{
	routeNotes = routeNotes.subString(0,300);
}

shortTitle = bugTitle;
if(shortTitle.length() > 240)
{
	shortTitle = shortTitle.subString(0,240);
}
if(plainFiles != "")
{
	details = details + "\n\n*Likely files:*\n" + plainFiles;
}
fitDesc = "";
fitNote = "";
fitFiles = "";
fitFilesBlock = "";
if(fitFiles != "")
{
	if(fitFiles.length() > 300)
	{
		fitFiles = fitFiles.subString(0,300);
	}
	fitFilesBlock = "\n\n*Likely files:*\n" + fitFiles;
}
fitNoteBlock = "";
if(fitNote != "")
{
	if(fitNote.length() > 300)
	{
		fitNote = fitNote.subString(0,299) + "…";
	}
	fitNoteBlock = "\n\n*AI note:* " + fitNote;
}
fitUpdRoom = 990 - fitFilesBlock.length() - fitNoteBlock.length() - fitDescLen;
if(fitUpdRoom < 300)
{
	fitUpdRoom = 300;
}
if(fitUpdatesBlock == "" && fitUpdates.size() > 0)
{
	// Even the newest update is too long on its own, so trim it.
	fitUpdatesBlock = fitUpdates.get(fitUpdates.size() - 1);
	fitUpdatesBlock = fitUpdatesBlock.subString(0,fitUpdRoom - 1) + "…";
}
fitRoom = 990 - fitFilesBlock.length() - fitNoteBlock.length() - fitUpdatesBlock.length();
if(fitRoom < 150)
{
	fitRoom = 150;
}
details = fitOut;
whereNote = "";
codeConf = result.get("code_confidence");
// keep only what routing needs, so the list fits in one field
compact = List();
whoText = "";
for each c in candidates
{
	entry = Map();
	entry.put("cliq",ifnull(c.get("cliq"),"").toString());
	entry.put("name",ifnull(c.get("name"),"").toString());
	entry.put("key",ifnull(c.get("key"),"").toString());
	entryPct = "";
	if(c.get("confidence") != null)
	{
		entryPct = c.get("confidence").toString();
	}
	entry.put("pct",entryPct);
	entryShare = "";
	if(c.get("share") != null)
	{
		entryShare = c.get("share").toString();
	}
	entry.put("share",entryShare);
	if(compact.size() == 0 && whereNote != "")
	{
		entry.put("where",whereNote);
	}
	compact.add(entry);
	who = c.get("name") + " (" + c.get("key") + ")";
	if(ifnull(c.get("cliq"),"") == "")
	{
		who = who + ", not linked";
	}
	whoText = whoText + "• " + who + "\n";
}
idPrefix = svcName.toUpperCase();
ticketId = idPrefix + "-" + nextNo.toString();
// Two reports at the same moment could get the same number, so skip any that are taken.
counters.put(svcName,nextNo.toString());
zoho.cliq.extension.setProperties({"counters":counters.toString()});
recordId = "";
routeId = "";
try
{
	metaText = severity + "," + svcName + "," + originChat + "," + reporter + "," + escalateTo.replaceAll(",",";").replaceAll(" ","") + "," + remindHours;
	meta = metaText.toList(",");
	createResp = zoho.cliq.createRecord(dbName,{"ticketid":ticketId,"title":shortTitle,"status":firstStatus,"assignee":"unassigned","meta":metaText,"details":details});
	recordId = createResp.get("object").get("id").toString();
	pendingNow = "";
	if(qText != "")
	{
		pendingNow = "triage";
	}
	routeCreate = zoho.cliq.createRecord(routeDb,{"ticketrec":recordId,"candidates":compact.toString(),"declined":"","pending":pendingNow,"questions":qText,"reminders":0,"changedat":nowMs});
	routeId = routeCreate.get("object").get("id").toString();
}
catch (err)
{
	return {"text":"Couldn't save the ticket. Check that the conduittickets and conduitroutes databases exist with the right fields and are part of the extension."};
}

dupStatus = "";
if(indexer.get("url") != null && indexer.get("secret") != null && svc.get("namespace") != null)
{
	try
	{
	}
	catch (err)
	{
		info "duplicate check skipped";
	}
}
if(dupRec != "")
{
	// hold the new report as a draft until the reporter decides
	zoho.cliq.updateRecord(dbName,recordId,{"status":"Draft"});
	zoho.cliq.updateRecord(routeDb,routeId,{"pending":"dup"});
	dupRows = List();
	dupRows.add({"Existing ticket":dupTicketId});
	dupRows.add({"Title":dupTitle});
	dupRows.add({"Status":dupStatusText});
	dupButtons = List();
	dupButtons.add({"label":"Join that ticket","type":"+","key":"dupjoin-" + recordId + "-" + dupRec,"action":{"type":"invoke.function","data":{"name":"conduitduplicate"}}});
	dupButtons.add({"label":"It's a different bug","type":"-","key":"dupnew-" + recordId,"action":{"type":"invoke.function","data":{"name":"conduitduplicate"}}});
	dupCard = {"text":"*" + shortTitle + "*\nThis looks like a bug that's already being tracked. Join it to get its updates, or file yours separately.","card":{"title":"Already reported?","theme":"modern-inline"},"slides":{{"type":"label","data":dupRows}},"buttons":dupButtons};
	dupSent = true;
	if(dupSent)
	{
		if(onBehalf)
		{
			return {"type":"banner","text":"This may already be reported. " + srcName + " can check in Flux.","status":"success"};
		}
		return {"type":"banner","text":"This may already be reported. Check Flux.","status":"success"};
	}
	dupCard.remove("userids");
	return dupCard;
}

if(fromMessage)
{
	// Post as Flux. Cliq needs a public image link, so the icon comes from the indexer.
	fluxBot = {"name":"Flux"};
	if(indexer.get("url") != null)
	{
		fluxBot.put("image",indexer.get("url") + "/flux.png");
	}
	trackMsg = {"text":"📌 Tracked as *" + ticketId + "* · " + shortTitle,"bot":fluxBot};
	if(srcMsg != "")
	{
		trackMsg.put("reply_to",srcMsg);
	}
	tracked = true;
	try
	{
		trackResp = zoho.cliq.postToChat(srcChat,trackMsg);
		if(trackResp != null && trackResp.get("code") != null)
		{
			tracked = false;
		}
	}
	catch (err)
	{
		tracked = false;
	}
	if(!tracked)
	{
		// try again as a plain message, without the reply link
		try
		{
			trackMsg.remove("reply_to");
			zoho.cliq.postToChat(srcChat,trackMsg);
		}
		catch (err)
		{
			info "could not post the tracking reply";
		}
	}
}


tTitle = shortTitle;
tDetails = details;
tSeverity = severity;
// Someone who left the organization cannot take the bug, so move on to the next candidate.
// Only a clean answer from Cliq counts; if the check fails, the bug goes out as usual.
activeDone = false;
for each activeTry in {1,2,3}
{
	if(!activeDone && newAssignee != "")
	{
		if(activeFound)
		{
			activeDone = true;
		}
		else
		{
			declined = declined + "," + newAssignee;
			newAssignee = "";
			for each activeCand in candList
			{
				activeEmail = ifnull(activeCand.get("cliq"),"").toString().toLowerCase();
				if(newAssignee == "" && activeEmail != "" && !declined.toList(",").contains(activeEmail))
				{
					newAssignee = activeEmail;
				}
			}
		}
	}
}
whereText = "";
confWho = "";
whoShown = 0;
lowConfidence = false;
if(newAssignee != "" && chosenPct < minConfidence)
{
	lowConfidence = true;
	newAssignee = "";
}
confText = "";
if(lowConfidence)
{
	filled = (chosenPct.toDecimal() / 20).round(0);
	meter = "";
	for each step in {1,2,3,4,5}
	{
		if(step <= filled)
		{
			meter = meter + "▰";
		}
		else
		{
			meter = meter + "▱";
		}
	}
	confText = "\n\n*Routing confidence:* " + meter + " " + chosenPct.toString() + "% (minimum " + minConfidence.toString() + "%)";
}
tcSvc = svc;
tcProjectName = svcName;
tcReporter = reporterLine;
tcDesc = "";
tcNote = "";
tcFileText = "";
tcText = "*" + tTitle.toString() + "*\n" + tcDesc;
tcRepoPath = "";
tcRef = "HEAD";
tcProject = tcProjectName;
if(tcSvc.get("owner") != null && tcSvc.get("repo") != null)
{
	tcRepoPath = tcSvc.get("owner").toString() + "/" + tcSvc.get("repo").toString();
	tcProject = tcProjectName + " (" + tcRepoPath + ")";
	tcBranch = ifnull(tcSvc.get("branch"),"").toString();
	if(tcBranch != "")
	{
		tcRef = tcBranch;
	}
}
tcBaseSlides = List();
tcDetailRows = List();
tcDetailRows.add({"Project":tcProject});
tcDetailRows.add({"Severity":tSeverity.toString()});
tcDetailRows.add({"Reported by":tcReporter});
if(tcAssignee != "" && tcAssignee != "unassigned")
{
	tcDetailRows.add({"Assigned to":tcAssignee});
}
tcDetailSlide = Map();
tcDetailSlide.put("type","label");
tcDetailSlide.put("title","Details");
// Each file line looks like "path (lines 1-20)". Link it when we know the repo.
tcFileItems = List();
tcFileLines = tcFileText.toList("\n");
if(tcFileItems.size() > 0)
{
	tcFileSlide = Map();
	tcFileSlide.put("type","list");
	tcFileSlide.put("title","Likely files");
	tcFileSlide.put("data",tcFileItems);
	tcBaseSlides.add(tcFileSlide);
}
if(tcExtra != "")
{
	tcExtraSlide = Map();
	tcExtraSlide.put("type","text");
	tcExtraSlide.put("title","Updates");
	tcExtraSlide.put("data",tcExtra);
	tcBaseSlides.add(tcExtraSlide);
}
// Team leads also see how much of the code each person wrote.
tcOwnerDev = List();
tcOwnerLead = List();
for each tcOc in candList
{
}
tcSlides = List();
tcSlides.addAll(tcBaseSlides);
tcLeadSlides = List();
tcLeadSlides.addAll(tcBaseSlides);
if(tcOwnerDev.size() > 0)
{
	tcDevTable = Map();
	tcDevTable.put("type","table");
	tcDevTable.put("title","Likely owners");
	tcDevTable.put("data",{"headers":{"Developer","GitHub","Cliq user"},"rows":tcOwnerDev});
	tcSlides.add(tcDevTable);
	tcLeadTable = Map();
	tcLeadTable.put("type","table");
	tcLeadTable.put("title","Likely owners");
	tcLeadTable.put("data",{"headers":{"Developer","GitHub","Cliq user","Share"},"rows":tcOwnerLead});
	tcLeadSlides.add(tcLeadTable);
}
cardText = tcText;
if(routeError != "")
{
	cardText = cardText + "\n⚠️ " + routeError;
}
openButtons = List();
openButtons.add({"label":"Accept","type":"+","key":"accept-" + recordId,"action":{"type":"invoke.function","data":{"name":"conduitticketaction"}}});
openButtons.add({"label":"Not mine","type":"-","key":"notmine-" + recordId,"action":{"type":"invoke.function","data":{"name":"conduitticketaction"}}});
openButtons.add({"label":"Won't fix","type":"-","key":"wontfix-" + recordId,"action":{"type":"invoke.function","data":{"name":"conduitticketaction"}}});
openButtons.add({"label":"Forward","type":"+","key":"forward-" + recordId,"action":{"type":"invoke.function","data":{"name":"conduitticketaction"}}});
openButtons.add({"label":"Need info","type":"+","key":"needinfo-" + recordId,"action":{"type":"invoke.function","data":{"name":"conduitticketaction"}}});
routeOutcome = "";
if(newAssignee != "")
{
	if(delivered)
	{
		zoho.cliq.updateRecord(dbName,recordId,{"status":"Open","assignee":newAssignee});
		routeOutcome = "Assigned to " + newAssignee;
		// Blockers also alert the team lead straight away.
		if(severityKey == "blocker" && !escalateTo.toLowerCase().contains(newAssignee))
		{
			try
			{
				alertMsg = Map();
				alertMsg.put("text","🚨 *Blocker filed:* *" + ticketId + "* · " + shortTitle + "\nAssigned to " + newAssignee + ". Reported by " + reporter + ".");
				alertMsg.put("userids",escalateTo);
				zoho.cliq.postToBot(botName,alertMsg);
			}
			catch (err)
			{
				info "could not alert the team lead about the blocker";
			}
		}
	}
	else
	{
		declined = declined + "," + newAssignee;
		routeOutcome = "";
		newAssignee = "";
	}
}
if(newAssignee == "")
{
	if(tcVerdict != "")
	{
		tcConfRows.add({"Who":tcVerdict});
	}
	tcDecideSlides = List();
	tcDecideSlides.addAll(tcBaseSlides);
	if(tcConfRows.size() > 0)
	{
		tcConfSlide = Map();
		tcConfSlide.put("type","label");
		tcConfSlide.put("title","Routing confidence");
		tcConfSlide.put("data",tcConfRows);
		tcDecideSlides.add(tcConfSlide);
	}
	if(tcOwnerLead.size() > 0)
	{
		tcDecideTable = Map();
		tcDecideTable.put("type","table");
		tcDecideTable.put("title","Likely owners");
		tcDecideTable.put("data",{"headers":{"Developer","GitHub","Cliq user","Share"},"rows":tcOwnerLead});
		tcDecideSlides.add(tcDecideTable);
	}
	leadButtons = List();
	if(lowConfidence)
	{
		for each b in openButtons
		{
			bKey = b.get("key");
			if(bKey.startsWith("forward-") || bKey.startsWith("needinfo-") || bKey.startsWith("wontfix-"))
			{
				leadButtons.add(b);
			}
		}
	}
	else
	{
		// Nobody owns it yet, so leave out Not mine.
		for each b in openButtons
		{
			if(!b.get("key").startsWith("notmine-"))
			{
				leadButtons.add(b);
			}
		}
	}
	routeOutcome = "With the " + svcName + " team";
}
// Conduit stats: who the bug went to first.
stMap = Map();
if(newAssignee != "")
{
	stMap.put("f",newAssignee);
	stMap.put("v","direct");
}
else
{
	stMap.put("f","lead");
	stMap.put("v","owner");
	if(lowConfidence)
	{
		stMap.put("v","lead");
	}
}
if(stIndex == 6)
{
	stMetaText = stMetaText + ",-";
	stIndex = 7;
}
if(stIndex == 7)
{
	try
	{
		zoho.cliq.updateRecord(dbName,recordId,{"meta":stMetaText + ",S:" + stText});
	}
	catch (err)
	{
		info "stats not saved";
	}
}
reporterRows.add({"Status":routeOutcome});
reporterButtons = List();
reporterButtons.add(shotButton);
return reporterCard;
